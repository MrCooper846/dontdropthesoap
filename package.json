{
  "name": "dont-drop-the-soap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:workers && tsx server.ts",
    "build": "npm run build:workers && next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "lint": "prettier --check \"server/**/*.{ts,mjs}\" \"domain/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.ts\" \"app/play/**/*.tsx\" \"app/bots/**/*.tsx\" \"app/yard/**/*.tsx\" \"client/**/*.{ts,tsx}\" components/YardMatchPanel.tsx components/YardVoicePanel.tsx components/MediaProbe.tsx components/VoiceProbe.tsx \"examples/**/*.ts\" server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:workers && vitest run",
    "test:browser": "playwright test",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop",
    "db:migrate": "tsx server/persistence/migrate.ts",
    "dev:legacy": "cross-env SOAP_LEGACY=true tsx legacy-server.ts",
    "test:alpha": "playwright test -c playwright.alpha.config.ts",
    "test:integration": "npm run build:workers && FEATURE_LEAGUE=true FEATURE_VISUAL_BOTS=true FEATURE_YARD=false DATABASE_URL=postgresql://soap:soap_local_only@localhost:55432/soap_test vitest run --config vitest.integration.config.mts",
    "test:recovery": "tsx tests/runtime/recovery.ts",
    "test:setup": "tsx scripts/init-test-dbs.ts",
    "legacy:archive": "tsx scripts/archive-legacy.ts",
    "test:yard": "playwright test -c playwright.yard.config.ts",
    "test:voice-spike": "playwright test -c playwright.voice-spike.config.ts",
    "test:voice": "playwright test -c playwright.voice.config.ts",
    "build:workers": "esbuild server/bots/visual-worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/workers/visual-worker.mjs",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:migrations": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@types/qrcode.react": "^1.0.5",
    "@types/sql.js": "^1.4.11",
    "blockly": "13.4.0",
    "cross-env": "^7.0.3",
    "dotenv": "18.0.8",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "mediasoup": "3.29.0",
    "mediasoup-client": "3.24.5",
    "next": "^15.3.2",
    "pg": "8.23.1",
    "phaser": "4.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sql.js": "^1.14.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.17",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.30",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "mediasoup@3.29.0": true,
    "esbuild@0.28.2": true
  }
}
