# Local-only credentials. Use unique random secrets and HTTPS when deploying.
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://soap:soap_local_only@localhost:55432/soap
SESSION_SECRET_PEPPER=local-development-pepper-change-before-deploying
COMMAND_KEY_SIGNING_SECRET=local-development-signing-change-before-deploying
MAX_YARD_PLAYERS=32
MAX_ACTIVE_MATCHES=4
MAX_ACTIVE_LEAGUE_FIXTURES=4
FEATURE_YARD=true
FEATURE_EXTERNAL_BOTS=true
FEATURE_VISUAL_BOTS=true
FEATURE_VOICE=false
FEATURE_LEAGUE=true
# Native media worker, loopback-only by default. Enable for local voice testing.
# Local Firefox ICE needs a reachable local-interface address instead of loopback.
VOICE_LISTEN_IP=127.0.0.1
VOICE_MIN_PORT=18000
VOICE_MAX_PORT=18127
# For deployment: bind to the media interface and advertise a reachable IP/DNS name.
# Open this port range for UDP/TCP separately from HTTPS.
# VOICE_ANNOUNCED_ADDRESS=your-media-host
